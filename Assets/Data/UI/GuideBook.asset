  - tabName: "\uACC4\uC808 \uC704\uD5D8"
    tabColor: {r: 0.9019608, g: 0.47058824, b: 0.50980395, a: 1}
    spreads:
    - left:
        title: "\uACC4\uC808 \uAC8C\uC774\uC9C0\uAC00 \uBB50\uC608\uC694?"
        subtitle: "\uD654\uBA74 \uC704\uCABD\uC5D0 \uC788\uB294 \uC774 \uCE78\uB4E4\uC774\uC5D0\uC694."
        heroImage: {fileID: 21300000, guid: d7056629476c3ff4d9f059b599280801, type: 3}
        heroHeight: 92
        description: "\uAF43\uAC00\uB8E8, \uBE57\uBC29\uC6B8, \uC740\uD589 \uB0C4\uC0C8,
          \uB208\uC1A1\uC774\uCC98\uB7FC \uACC4\uC808\uC758 '\uC704\uD5D8\uD55C \uAC83'\uC5D0
          \uB2FF\uC744 \uB54C\uB9C8\uB2E4 \uD55C \uCE78\uC529 \uCC28\uC694.\n\n\uCE78\uC774
          \uAF49 \uCC28\uBA74? \uADF8 \uACC4\uC808\uC758 \uB514\uBC84\uD504\uAC00
          \uAC78\uB824\uC694! \uC7A0\uAE50 \uC9C0\uB098\uBA74 \uD480\uB9AC\uACE0
          \uAC8C\uC774\uC9C0\uB3C4 \uBE44\uC6CC\uC838\uC694."
        entries: []
        tipTitle: 
        tipText: 
      right:
        title: "\uB514\uBC84\uD504 4\uC885"
        subtitle: 
        heroImage: {fileID: 0}
        heroHeight: 0
        description: 
        entries:
        - icon: {fileID: 21300000, guid: 58bd2c334130b61499198d0f5919a4ed, type: 3}
          title: "\uBD04 \xB7 \uC18D\uBC15"
          keyLabel: 
          body: "\uAF43\uAC00\uB8E8\uC5D0 \uCE6D\uCE6D! \uC7A0\uAE50 \uAF3C\uC9DD
            \uBABB \uD574\uC694."
          highlight: 
        - icon: {fileID: 21300000, guid: 2b78908c9c54a754b999ac490d5e11fb, type: 3}
          title: "\uC5EC\uB984 \xB7 \uB290\uB824\uC9D0"
          keyLabel: 
          body: "\uBE44\uC5D0 \uD760\uBED1 \uC816\uC5B4 \uBAB8\uC774 \uBB34\uAC70\uC6CC\uC838\uC694."
          highlight: 
        - icon: {fileID: 21300000, guid: 636abacc024b4f8488a6d54cdfcacc7d, type: 3}
          title: "\uAC00\uC744 \xB7 \uBC29\uD5A5 \uBC18\uC804"
          keyLabel: 
          body: "\uC740\uD589 \uB0C4\uC0C8\uC5D0 \uC815\uC2E0\uC774 \uD63C\uBBF8\u2026
            \u2190\u2192\uAC00 \uB4A4\uBC14\uB00C\uC5B4\uC694."
          highlight: 
        - icon: {fileID: 21300000, guid: ce01219100179ad45aa70d8bf7af243d, type: 3}
          title: "\uACA8\uC6B8 \xB7 \uC5BC\uC5B4\uBD99\uC74C"
          keyLabel: 
          body: "\uAF41\uAF41! \uC7A0\uC2DC \uC544\uBB34\uAC83\uB3C4 \uBABB \uC6C0\uC9C1\uC5EC\uC694."
          highlight: 
        tipTitle: 
        tipText: 
    - left:
        title: "\uACC4\uC808\uBCC4 \uC0DD\uC874 \uC694\uB839"
        subtitle: "\uB9C9\uC744 \uC218 \uC788\uB294 \uAC74 \uB9C9\uACE0, \uB0A0\uB9B4
          \uC218 \uC788\uB294 \uAC74 \uB0A0\uB824\uC694!"
        heroImage: {fileID: 0}
        heroHeight: 0
        description: 
        entries:
        - icon: {fileID: 21300000, guid: 58bd2c334130b61499198d0f5919a4ed, type: 3}
          title: "\uBD04 \u2014 \uAF43\uAC00\uB8E8"
          keyLabel: 
          body: "\uC0B4\uB791\uC0B4\uB791 \uD754\uB4E4\uB9AC\uBA70 \uB5A8\uC5B4\uC838\uC694."
          highlight: "\uC6B0\uC0B0\uC73C\uB85C \uB9C9\uAE30 / \uC120\uD48D\uAE30\uB85C
            \uB0A0\uB824 \uBC84\uB9AC\uAE30"
        - icon: {fileID: 21300000, guid: 2b78908c9c54a754b999ac490d5e11fb, type: 3}
          title: "\uC5EC\uB984 \u2014 \uBE44"
          keyLabel: 
          body: "\uD6C4\uB4DC\uB4DD \uC3DF\uC544\uC9C0\uB294 \uBE57\uBC29\uC6B8."
          highlight: "\uC6B0\uC0B0 \uD3B4\uACE0 \uAC78\uC73C\uBA74 \uB044\uB5A1\uC5C6\uC5B4\uC694"
        tipTitle: 
        tipText: 
      right:
        title: 
        subtitle: 
        heroImage: {fileID: 0}
        heroHeight: 0
        description: 
        entries:
        - icon: {fileID: 21300000, guid: 636abacc024b4f8488a6d54cdfcacc7d, type: 3}
          title: "\uAC00\uC744 \u2014 \uC740\uD589"
          keyLabel: 
          body: "\uC5F4\uB9E4\uAC00 \uB5A8\uC5B4\uC838 \uD130\uC9C0\uBA74 \uB0C4\uC0C8\uAC00
            \uB0A8\uC544\uC694."
          highlight: "\uB5A8\uC5B4\uC9C8 \uB550 \uC6B0\uC0B0, \uB0A8\uC740 \uB0C4\uC0C8\uB294
            \uC120\uD48D\uAE30\uB85C \uD6C5!"
        - icon: {fileID: 21300000, guid: ce01219100179ad45aa70d8bf7af243d, type: 3}
          title: "\uACA8\uC6B8 \u2014 \uB208\uACFC \uC5BC\uC74C"
          keyLabel: 
