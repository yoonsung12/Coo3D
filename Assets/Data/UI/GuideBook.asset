  welcomeLeft:
    title: "\uB3C4\uC2DC \uC0DD\uC874 \uAC00\uC774\uB4DC\uBD81"
    subtitle: "\uCC98\uC74C \uC624\uC168\uAD70\uC694! \uBC18\uAC00\uC6CC\uC694 :)"
    heroImage: {fileID: 21300000, guid: e9e03a739c861b24c8b55be7aa526e87, type: 3}
    heroHeight: 260
    description: "\uC774 \uB3C4\uC2DC\uB294 \uACC4\uC808\uB9C8\uB2E4 \uC5BC\uAD74\uC774
      \uBC14\uB00C\uC5B4\uC694. \uBD04\uC5D4 \uAF43\uAC00\uB8E8\uAC00, \uC5EC\uB984\uC5D4
      \uBE44\uAC00, \uAC00\uC744\uC5D4 \uC740\uD589\uC774, \uACA8\uC6B8\uC5D4 \uB208\uC774
      \uC3DF\uC544\uC9C0\uC8E0.\n\uADF8\uB9AC\uACE0\u2026 \uBE44\uB458\uAE30\uAC00
      \uC544\uC8FC, \uC544\uC8FC \uB9CE\uC544\uC694.\n\n\uC774 \uC218\uCCA9\uC5D0
      \uC0B4\uC544\uB0A8\uB294 \uC694\uB839\uC744 \uC801\uC5B4 \uB480\uC5B4\uC694.
      \uAE38\uC744 \uC783\uC73C\uBA74 \uC5B8\uC81C\uB4E0 \uD3BC\uCCD0 \uBCF4\uC138\uC694!"
    entries: []
    tipTitle: 
    tipText: 
  welcomeRight:
    title: "\uC774 \uC218\uCCA9 \uBCF4\uB294 \uBC95"
    subtitle: 
    heroImage: {fileID: 0}
    heroHeight: 0
    description: 
    entries:
    - icon: {fileID: 0}
