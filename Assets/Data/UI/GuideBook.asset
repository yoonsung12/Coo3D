  tabs:
  - tabName: "\uC870\uC791\uBC95"
    tabColor: {r: 0.47058824, g: 0.6666667, b: 0.8235294, a: 1}
    spreads:
    - left:
        title: "\uBAB8 \uC4F0\uB294 \uBC95"
        subtitle: "\uD0A4\uBCF4\uB4DC\uB9CC \uC788\uC73C\uBA74 \uB3FC\uC694. \uB9C8\uC6B0\uC2A4\uB294
          \uC7A0\uAE50 \uC26C\uAC8C \uD574 \uC8FC\uC138\uC694!"
        heroImage: {fileID: 0}
        heroHeight: 0
        description: 
        entries:
        - icon: {fileID: 0}
          title: 
          keyLabel: "\u2190 \u2191 \u2193 \u2192"
          body: "\uC774\uB3D9 (\u2191/\u2193\uB294 \uC55E\uB4A4\uB85C \uC6C0\uC9C1\uC5EC\uC694)"
          highlight: 
        - icon: {fileID: 0}
          title: 
          keyLabel: C
          body: "\uC810\uD504 \u2014 \uAE38\uAC8C \uB204\uB97C\uC218\uB85D \uB192\uC774
            \uB6F0\uC5B4\uC694"
          highlight: 
        - icon: {fileID: 0}
          title: 
          keyLabel: X
          body: "\uACF5\uACA9 / \uC9C0\uAE08 \uB4E0 \uB3C4\uAD6C \uC4F0\uAE30"
          highlight: 
        - icon: {fileID: 0}
          title: 
          keyLabel: Z
          body: "\uB204\uB978 \uCC44 \uD654\uC0B4\uD45C\uB85C \uB3C4\uAD6C \uACE0\uB974\uAE30"
          highlight: 
        - icon: {fileID: 0}
          title: 
          keyLabel: Space
          body: "\uAFB9~ \uB204\uB974\uBA74 \uC0C1\uD638\uC791\uC6A9 (\uC790\uD310\uAE30\xB7\uC7A5\uCE58)"
          highlight: 
        - icon: {fileID: 0}
          title: 
          keyLabel: Shift
          body: "\uB204\uB978 \uCC44 X \uAFB9 \u2192 \uC120\uD48D\uAE30 \uCDA9\uC804"
          highlight: 
        - icon: {fileID: 0}
          title: 
          keyLabel: Esc
          body: "\uC77C\uC2DC\uC815\uC9C0"
          highlight: 
        - icon: {fileID: 0}
          title: 
          keyLabel: F1
          body: "\uC774 \uAC00\uC774\uB4DC\uBD81"
          highlight: 
        tipTitle: 
        tipText: 
      right:
        title: "\uC774\uB7F4 \uB550 \uC774\uB807\uAC8C!"
        subtitle: 
        heroImage: {fileID: 0}
        heroHeight: 0
        description: 
        entries:
        - icon: {fileID: 0}
          title: "\uC2DC\uC810\uC774 \uBC14\uB00C\uC5C8\uC5B4\uC694?!"
          keyLabel: 
          body: "\uC5B4\uB5A4 \uAD6C\uC5ED\uC5D0 \uB4E4\uC5B4\uAC00\uBA74 \uD558\uB298\uC5D0\uC11C
            \uB0B4\uB824\uB2E4\uBCF4\uB294 \uC2DC\uC810\uC73C\uB85C \uBC14\uB00C\uC5B4\uC694.
            \uB2F9\uD669\uD558\uC9C0 \uB9D0\uACE0 \uD654\uC0B4\uD45C\uB85C 8\uBC29\uD5A5
            \uC790\uC720\uB86D\uAC8C \uAC78\uC5B4 \uB2E4\uB2C8\uBA74 \uB3FC\uC694."
          highlight: 
        - icon: {fileID: 0}
          title: "\uB192\uC774 \uB6F0\uACE0 \uC2F6\uC73C\uBA74 \uAFB9~"
          keyLabel: 
          body: "C\uB97C \uD1A1 \uB204\uB974\uBA74 \uB0AE\uAC8C, \uAE38\uAC8C \uB204\uB974\uACE0
            \uC788\uC73C\uBA74 \uB354 \uB192\uC774 \uB6F0\uC5B4\uC694. \uADF8\uB798\uB3C4
            \uC548 \uB2FF\uC73C\uBA74 \uADFC\uCC98\uC5D0 \uB2E4\uB978 \uAE38\uC774
            \uC228\uC5B4 \uC788\uC744\uC9C0\uB3C4\uC694."
          highlight: 
        - icon: {fileID: 0}
          title: "\uC0C1\uD638\uC791\uC6A9\uC740 '\uAFB9'"
          keyLabel: 
          body: "Space\uB97C \uD1A1 \uB204\uB974\uBA74 \uBC18\uC751\uC774 \uC5C6\uC5B4\uC694.
            \uAFB9 \uB204\uB974\uACE0 \uC788\uC5B4\uC57C \uC790\uD310\uAE30\uB098
            \uC7A5\uCE58\uAC00 \uC6C0\uC9C1\uC5EC\uC694."
          highlight: 
        tipTitle: 
        tipText: 
  - tabName: "\uB3C4\uAD6C"
    tabColor: {r: 0.9411765, g: 0.6666667, b: 0.3137255, a: 1}
    spreads:
    - left:
        title: "\uB0B4 \uC190 \uC548\uC758 \uB3C4\uAD6C\uB4E4"
        subtitle: "Z\uB97C \uB204\uB978 \uCC44 \uD654\uC0B4\uD45C\uB85C \uACE8\uB77C\uC694.
          \uC0C1\uD669 \uB9DE\uCDB0 \uBC14\uAFD4 \uB07C\uB294 \uAC8C \uC0DD\uC874\uC758
          \uBE44\uACB0!"
        heroImage: {fileID: 0}
        heroHeight: 0
        description: 
        entries:
        - icon: {fileID: 21300000, guid: f5c4dd5a26858b3428206d1403763ce1, type: 3}
          title: "\uBC30\uAC8C"
          keyLabel: "Z+\u2191"
          body: "\uD479\uC2E0\uD574 \uBCF4\uC5EC\uB3C4 \uBE44\uB458\uAE30\uD55C\uD150
            \uAF64 \uC544\uD30C\uC694! X\uB85C \uD718\uB458\uB7EC\uC11C \uADC0\uCC2E\uAC8C
            \uAD6C\uB294 \uB140\uC11D\uB4E4\uC744 \uD63C\uB0B4 \uC8FC\uC138\uC694."
          highlight: 
        - icon: {fileID: 21300000, guid: f1424908eb945d446a176f93ad0ce935, type: 3}
          title: "\uC120\uD48D\uAE30"
          keyLabel: "Z+\u2190"
          body: "X\uB85C \uBC14\uB78C\uC744 \uC3F4\uC11C \uC0C1\uC790\uB97C \uBC00\uACE0,
            \uAF43\uAC00\uB8E8\uB97C \uB0A0\uB9AC\uACE0, \uC740\uD589 \uB0C4\uC0C8\uB3C4
            \uD6C5 \uD769\uC5B4 \uBC84\uB824\uC694. Shift+X\uB97C \uAFB9 \uBAA8\uC558\uB2E4
            \uB5BC\uBA74\u2026 \uBE75! \uAC15\uD48D \uBC1C\uC0AC."
          highlight: 
        tipTitle: 
        tipText: 
      right:
        title: 
        subtitle: 
        heroImage: {fileID: 0}
        heroHeight: 0
        description: 
        entries:
        - icon: {fileID: 21300000, guid: 4d493f23f4ccd1a4483b39985b1ac311, type: 3}
          title: "\uC6B0\uC0B0"
          keyLabel: "Z+\u2193"
          body: "\uBE44\xB7\uAF43\uAC00\uB8E8\xB7\uB5A8\uC5B4\uC9C0\uB294 \uC740\uD589\uC744
            \uB9C9\uC544 \uC918\uC694. \uB192\uC740 \uB370\uC11C \uB5A8\uC5B4\uC9C8
            \uB54C \uD3BC\uCE58\uBA74 \uC0B4\uB791\uC0B4\uB791 \uCC9C\uCC9C\uD788
            \uB0B4\uB824\uC640\uC694."
          highlight: 
        - icon: {fileID: 21300000, guid: 32d6ef6491d09e141987bc01c0efbcaa, type: 3}
          title: "\uD683\uBD88"
          keyLabel: "Z+\u2192"
          body: "\uC5B4\uB450\uC6B4 \uACF3\uC744 \uBC1D\uD788\uACE0 \uB3C4\uD654\uC120\uC5D0
            \uBD88\uC744 \uBD99\uC5EC\uC694. \uAC8C\uC774\uC9C0 \uD0C0\uC774\uBC0D\uC5D0
            \uB9DE\uCDB0 X! \uB193\uCCD0\uB3C4 \uB2E4\uC2DC \uD558\uBA74 \uB3FC\uC694."
          highlight: 
        tipTitle: TIP
        tipText: "\uC544\uC9C1 \uBABB \uC5BB\uC740 \uB3C4\uAD6C\uB294 ? \uB85C \uBCF4\uC5EC\uC694.\n\uAD6C\uC5ED\uC744
          \uC9C0\uB098\uBA70 \uD558\uB098\uC529 \uC190\uC5D0 \uB123\uAC8C \uB420
          \uAC70\uC608\uC694 :)"
  - tabName: "\uBE44\uB458\uAE30"
    tabColor: {r: 0.6666667, g: 0.54901963, b: 0.78431374, a: 1}
    spreads:
    - left:
        title: "\uBE44\uB458\uAE30"
        subtitle: "\uC774 \uB3C4\uC2DC\uC758 \uC9C4\uC9DC \uC8FC\uC778 (\uC774\uB77C\uACE0
          \uBCF8\uC778\uB4E4\uC740 \uC0DD\uAC01\uD568)"
